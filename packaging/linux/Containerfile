# Linux build environment for Magnetite: Rust, cmake, Ninja, Node and pnpm, plus
# the libraries CEF links against and Xvfb for headless runs. Used by
# scripts/linux-container.sh; CI uses Ubuntu runners instead.
#
#   podman build -t magnetite-linux-builder --build-arg RUST_TOOLCHAIN=1.99 packaging/linux
FROM docker.io/library/node:22-bookworm AS node

FROM docker.io/library/rust:1-bookworm
ARG RUST_TOOLCHAIN
RUN apt-get update && apt-get install -y --no-install-recommends \
      cmake ninja-build pkg-config patchelf python3 xvfb xauth \
      libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
      libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
      libpango-1.0-0 libcairo2 libasound2 libglib2.0-0 libdbus-1-3 libx11-6 \
      libxcb1 libxext6 libexpat1 libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install --global pnpm@10 \
    && test -n "$RUST_TOOLCHAIN" \
    && rustup toolchain install "$RUST_TOOLCHAIN" --profile minimal --component clippy,rustfmt
