<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- "magnetite Helper.app": Chromium starts the process for protected video
     in it and loads the Widevine module there, which Google signs. Under the
     hardened runtime macOS loads only libraries of our own team without
     this. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
